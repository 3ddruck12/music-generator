{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "webapp",
  "description": "Die lokale Web-App darf nur ihre Sprache melden und Downloads an die Hülle geben.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://localhost:8765/*",
      "http://127.0.0.1:8765/*"
    ]
  },
  "permissions": [
    "allow-set-lang",
    "allow-save-download",
    "allow-reveal-download"
  ]
}
